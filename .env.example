MONGO_URI=
DB_NAME=

# Backend API origin
NEXT_PUBLIC_API_BASE_URL=https://octacore.githubsrmist.in

# Read-only key for public display reads (team, sponsors, events, certificate verify).
# Shipped to the browser intentionally — the backend restricts it to non-PII reads.
NEXT_PUBLIC_PUBLIC_API_KEY=

# Admin/service key used by the server-side proxy (pages/api/certificate/generate).
# Server-only: never prefix this with NEXT_PUBLIC_.
SERVICE_API_KEY=
